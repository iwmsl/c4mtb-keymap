#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,physical-layout = &c4mtb_physical_layout;
    };

    /*
     * Binding order is left-to-right as viewed from above:
     *   3 rows x (5L + 5R), then 4 left and 4 right lower keys.
     * Coordinates are expressed in centi-key-units and match config/info.json.
     * x/y are the key's top-left corner, so a 150-wide key
     * starts 25 further left than a 100-wide key on the same centre; rx/ry are
     * the rotation origin and stay on the centre. The halves are separated only
     * for Studio display. scripts/verify_firmware_hardware.py checks all 38.
     */
    c4mtb_physical_layout: c4mtb_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "c4mtb 3x5+4";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  // w   h    x    y       rot    rx    ry
            = <&key_physical_attrs 100 100    0   38         0     0     0>
            , <&key_physical_attrs 100 100  100   13         0     0     0>
            , <&key_physical_attrs 100 100  200    0         0     0     0>
            , <&key_physical_attrs 100 100  300   13         0     0     0>
            , <&key_physical_attrs 100 100  400   25         0     0     0>
            , <&key_physical_attrs 100 100  700   25         0     0     0>
            , <&key_physical_attrs 100 100  800   13         0     0     0>
            , <&key_physical_attrs 100 100  900    0         0     0     0>
            , <&key_physical_attrs 100 100 1000   13         0     0     0>
            , <&key_physical_attrs 100 100 1100   38         0     0     0>

            , <&key_physical_attrs 100 100    0  138         0     0     0>
            , <&key_physical_attrs 100 100  100  113         0     0     0>
            , <&key_physical_attrs 100 100  200  100         0     0     0>
            , <&key_physical_attrs 100 100  300  113         0     0     0>
            , <&key_physical_attrs 100 100  400  125         0     0     0>
            , <&key_physical_attrs 100 100  700  125         0     0     0>
            , <&key_physical_attrs 100 100  800  113         0     0     0>
            , <&key_physical_attrs 100 100  900  100         0     0     0>
            , <&key_physical_attrs 100 100 1000  113         0     0     0>
            , <&key_physical_attrs 100 100 1100  138         0     0     0>

            , <&key_physical_attrs 100 100    0  238         0     0     0>
            , <&key_physical_attrs 100 100  100  213         0     0     0>
            , <&key_physical_attrs 100 100  200  200         0     0     0>
            , <&key_physical_attrs 100 100  300  213         0     0     0>
            , <&key_physical_attrs 100 100  400  225         0     0     0>
            , <&key_physical_attrs 100 100  700  225         0     0     0>
            , <&key_physical_attrs 100 100  800  213         0     0     0>
            , <&key_physical_attrs 100 100  900  200         0     0     0>
            , <&key_physical_attrs 100 100 1000  213         0     0     0>
            , <&key_physical_attrs 100 100 1100  238         0     0     0>

            , <&key_physical_attrs 100 100  250  325         0     0     0>
            , <&key_physical_attrs 100 100  359  336      1194   409   386>
            , <&key_physical_attrs 150 100  449  347    (-6612)  524   397>
            , <&key_physical_attrs 100 100  500  175         0     0     0>
            , <&key_physical_attrs 100 100  600  175         0     0     0>
            , <&key_physical_attrs 150 100  601  347      6612   676   397>
            , <&key_physical_attrs 100 100  741  336    (-1194)  791   386>
            , <&key_physical_attrs 100 100 1100  338         0     0     0>
            ;
    };

    /*
     * PCB nets are 4x5 on each half. Left Col0..4 run outer-to-inner,
     * right Col0..4 run inner-to-outer. The only unused points are
     * L Row3/Col0 and R Row3/Col3.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                    RC(3,1) RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)         RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * No base input-processors on purpose: an auto-mouse layer (zip_temp_layer)
     * fires on any pointer motion, so a brushed ball would silently shift the
     * keymap mid-typing. Scrolling is entered from a held key instead, via the
     * layer override in c4mtb_r.overlay.
     */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};
