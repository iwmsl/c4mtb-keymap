+/* IRQ work and the health check share the system workqueue. Never reset
+ * solely because there is no motion: a stationary ball is healthy. */
+static void pmw3610_recover_locked(const struct device *dev) {
+    struct pixart_data *data = dev->data;
+    pmw3610_set_interrupt(dev, false);
+    data->ready = false;
+    data->async_init_step = 0;
+    data->async_init_retry_count = 0;
+    data->sw_smart_flag = false;
+    data->dx = data->dy = 0;
+    data->last_smp_time = data->last_rpt_time = 0;
+    data->recovery_errors = 0;
+    LOG_WRN("PMW3610 recovering sensor; keyboard remains connected");
+    k_work_reschedule(&data->init_work, K_MSEC(async_init_delay[0]));
+}
+
+static void pmw3610_health_check(struct k_work *work) {
+    struct pixart_data *data = CONTAINER_OF(k_work_delayable_from_work(work),
+                                          struct pixart_data, health_work);
+    const struct device *dev = data->dev;
+    const struct pixart_config *config = dev->config;
+    if (data->suspended) {
+        return;
+    }
+    /* Do not queue behind Studio frame capture or other long operations. */
+    if (k_mutex_lock(&data->lock, K_NO_WAIT) != 0) {
+        goto again;
+    }
+    if (data->capture_active) {
+        k_mutex_unlock(&data->lock);
+        goto again;
+    }
+    if (!data->ready) {
+        /* Retry an exhausted init without rebooting the keyboard. */
+        if (data->err && data->async_init_retry_count >= 10) {
+            pmw3610_recover_locked(dev);
+        }
+        k_mutex_unlock(&data->lock);
+        goto again;
+    }
+    uint8_t product_id = 0;
+    int err = pmw3610_read_reg(dev, PMW3610_REG_PRODUCT_ID, &product_id);
+    if (!err && product_id != PMW3610_PRODUCT_ID) {
+        err = -EIO;
+    }
+    int motion = gpio_pin_get_dt(&config->irq_gpio);
+    if (!err && motion < 0) {
+        err = motion;
+    }
+    if (err) {
+        pmw3610_set_interrupt(dev, false);
+        if (++data->recovery_errors >= 3) {
+            pmw3610_recover_locked(dev);
+        }
+    } else if (motion > 0 || data->recovery_errors) {
+        /* Also covers a missed/disabled MOTION interrupt and failed reports.
+         * Do not clear errors until an actual report transaction succeeds. */
+        k_work_submit(&data->trigger_work);
+    } else {
+        err = pmw3610_set_interrupt(dev, true);
+        if (err && ++data->recovery_errors >= 3) {
+            pmw3610_recover_locked(dev);
+        }
+    }
+    k_mutex_unlock(&data->lock);
+again:
+    k_work_reschedule(&data->health_work, K_SECONDS(1));
+}
+
