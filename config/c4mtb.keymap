#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
};

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        cursor_speed: cursor_speed {
            compatible = "c4mtb,behavior-cursor-speed";
            display-name = "Cursor Speed";
            #binding-cells = <0>;
        };
    };

    macros {
        /*
         * ボールでズームするためのレイヤー。押している間だけ LCTRL を保持し、
         * 同時にレイヤー5へ入る。レイヤー5では c4mtb_r.overlay の zoomer が
         * ホイールのゲインを1/8へ落とすので、Ctrl+ホイールのズームが
         * 「球を約4mm転がして1段」になる。
         *
         * ZMKにはモディファイア保持とレイヤー保持を1つにする振る舞いがないので
         * マクロで束ねる。macro_pause_for_release があるため、押し下げで
         * &kp LCTRL と &mo 5 の両方が押され、キーを離すと両方が離れる。
         */

        zoom_ball: zoom_ball {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL &mo 5>;
        };
    };

    /*
     * Combos stay in standard ZMK devicetree so Keymap Editor can parse,
     * display, and edit them without depending on DYA runtime-combo state.
     * Recovery controls and click chords therefore remain available even if
     * Studio settings are reset or Studio itself is unavailable.
     */

    combos {
        compatible = "zmk,combos";

        settings_layer {
            timeout-ms = <80>;
            key-positions = <33 34>;
            bindings = <&mo 4>;
        };

        left_click {
            key-positions = <16 17>;
            bindings = <&mkp LCLK>;
            timeout-ms = <90>;
        };

        right_click {
            key-positions = <17 18>;
            bindings = <&mkp RCLK>;
            timeout-ms = <90>;
        };
        tab_shift_combo {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&kp LS(TAB)>;
        };
        tab_combo {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &mt LEFT_WIN W      &kp E         &kp R        &kp T    &kp Y         &kp U        &kp I            &kp O             &kp P
&mt LCTRL A       &mt LEFT_ALT S      &mt LSHIFT D  &kp F        &kp G    &kp H         &kp J        &lt 3 K          &mt LEFT_ALT L    &mt LCTRL MINUS
&mt LEFT_SHIFT Z  &mt LEFT_ALT X      &kp C         &kp V        &kp B    &kp N         &kp M        &kp COMMA        &mt LEFT_ALT DOT  &mt LEFT_SHIFT SLASH
                  &lt 3 INT_MUHENKAN  &lt 2 DEL     &lt 1 SPACE  &kp  LCTRL  &kp LEFT_ALT  &lt 1 ENTER  &lt 2 BACKSPACE                    &lt 5 INT_HENKAN
            >;
        };

        number_layer {
            bindings = <
&kp PAGE_UP    &kp LS(F10)     &kp UP              &mkp LCLK            &mkp RCLK   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_MINUS   &kp KP_SLASH
&kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT            &kp F6      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_PLUS    &kp KP_MULTIPLY
&kp HOME       &kp END         &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LS(F6)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(MINUS)  &trans
               &trans          &trans              &trans               &kp ESCAPE  &kp COMMA     &trans        &kp NUMBER_0                 &kp PERIOD
            >;
        };

        navigation_layer {
            bindings = <
&kp LC(PAGE_UP)    &trans              &kp LG(UP)          &trans               &kp LS(COMMA)      &kp LS(PERIOD)    &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_6)
&kp LC(PAGE_DOWN)  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp LS(NUMBER_7)  &kp SEMICOLON     &kp SQT           &kp LS(SEMICOLON)
&kp LS(HOME)       &kp LS(END)         &kp LC(Z)           &kp LC(Y)            &kp LS(N8)         &kp LS(NUMBER_9)  &kp LS(NUMBER_1)  &kp LS(SLASH)     &kp LS(NUMBER_5)  &kp LS(INT_RO)
                   &trans              &trans              &trans               &kp LA(F4)         &kp LEFT_BRACKET  &trans            &trans                              &trans
            >;
        };

        /*
         * Layer 3. Held via &lt 3 on the left outer thumb / right corner key.
         * The trackball scrolls instead of moving the cursor while this layer
         * is active (see the scroller override in c4mtb_r.overlay).
         *
         * &msc の引数は単位/秒。CONFIG_ZMK_POINTING_SMOOTH_SCROLLING により
         * 1ノッチ = 16単位になったので、以前の MOVE_Y(5)(=5ノッチ/秒)と同じ
         * 速さは MOVE_Y(80) になる。有効化前の値のままだと1/16の速度で
         * 「効かない」ように見える。
         *
         * 左内側の拡張キー(位置33、ベースはTAB)は &zoom_ball。左親指でこの
         * レイヤーを保持したまま左人差し指で押し、右手はボールに置いたまま
         * ズームできる位置を選んだ。位置33は settings_layer コンボ(33+34)の
         * 片側でもあるため、単押しの確定はコンボのtimeout-ms(80ms)ぶん遅れる。
         * 押してから転がすぶんには問題ないが、気になるならコンボを持たない
         * 位置4(ベースはT)へ移す。
         */

        scroll_layer {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &trans         &msc MOVE_Y(80)   &trans              &trans               &trans    &trans
&kp F5  &kp F6   &kp F7   &kp F8   &kp LA(LS(B))  &msc MOVE_Y(-80)  &mkp MB1            &trans               &mkp MB2  &trans
&kp F9  &kp F10  &kp F11  &kp F12  &kp LG(LC(S))  &trans            &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans    &trans
        &trans   &trans   &trans   &trans         &trans            &trans              &trans                         &trans
            >;
        };

        /* Layer 4. Entered by the combo on both inner extension keys. */

        settings_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock  &cursor_speed  &trans  &trans  &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans      &bt BT_CLR_ALL
&bootloader   &sys_reset    &trans        &trans        &trans        &trans          &trans  &trans  &sys_reset  &bootloader
              &trans        &trans        &trans        &trans        &trans          &trans  &trans              &trans
            >;
        };

        /*
         * Layer 5. Entered only from &zoom_ball on layer 3, which holds LCTRL
         * for as long as the key is down. キー自体に割り当てはなく、
         * c4mtb_r.overlay の zoomer(レイヤー5)がボールのホイールゲインを
         * 落とすためだけに存在する。押している間はレイヤー3も生きているので
         * 全キーを &trans にしてレイヤー3へ落とす。
         */

        zoom_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
            >;
        };
    };
};
